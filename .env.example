# Copy to .env.local (web) / set in agent config.json (desktop) / Convex env.

# --- Convex (backend) ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Shared secret the desktop agent presents to the /ingest HTTP endpoint.
# Set this in the Convex dashboard env vars AND in each agent's config.json.
ACTIVITYTRACK_INGEST_KEY=

# --- Desktop agent (per-machine config.json mirrors these) ---
ACTIVITYTRACK_CONVEX_URL=        # https://<deployment>.convex.site

# --- Auth provider (web) — fill in once chosen (Convex Auth or Clerk) ---
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
