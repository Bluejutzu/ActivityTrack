# Copy to .env.local (web) / set in tracker config.json (desktop) / Convex env.

# --- Convex (backend) ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=        # https://<deployment>.convex.cloud  (web dashboard)

# Desktop agents authenticate with a per-device token (convex-api-tokens
# component), minted at approval and stored hash-only — there is no shared
# ingest secret anymore. API_TOKENS_ENCRYPTION_KEY is only needed if you also
# use the component's encrypted third-party key storage (device tokens don't):
#   npx convex env set API_TOKENS_ENCRYPTION_KEY <a-long-random-secret>
API_TOKENS_ENCRYPTION_KEY=

# --- Clerk auth (dashboard) ---
# Identity is owned by Clerk; Convex verifies the Clerk JWT. Create a Clerk app,
# then add a JWT template named "convex" (Clerk dashboard → JWT Templates).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=   # pk_test_... / pk_live_...  (web dashboard)
CLERK_SECRET_KEY=                    # sk_test_... / sk_live_...  (web dashboard)
# The Clerk instance issuer URL (e.g. https://your-app.clerk.accounts.dev).
# Set as a Convex deployment env var so the backend can verify tokens:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# --- Dashboard access control (single-tenant internal tool) ---
# Permanent admins: a comma-separated list of email addresses that are ALWAYS
# it_admin and can never be locked out. Set as a Convex deployment env var:
#   npx convex env set ACTIVITYTRACK_ADMIN_EMAILS "boss1@company.com, boss2@company.com"
# Everyone else signs in only if their email DOMAIN is on the allow-list, which
# admins manage in the dashboard (Settings → Access) — no redeploy needed.
# Safety net: if this is unset AND no users exist yet, the first sign-in becomes
# admin so a fresh deployment is never left admin-less.
ACTIVITYTRACK_ADMIN_EMAILS=

# --- Desktop tracker (per-machine config.json mirrors these; no secrets) ---
ACTIVITYTRACK_CONVEX_URL=      # https://<deployment>.convex.site  (tracker → /ingest, /agent/*)
ACTIVITYTRACK_API_URL=         # https://<your-dashboard>          (tracker → /api/agent/register, /api/agent/poll)

# --- Fused employee-state engine (Genesys + Clockodo integration) ---
# Shared secret the dashboard's Elysia API layer presents to Convex
# `state.pushSignal` (server-to-server). Set it in BOTH the Convex deployment
# env AND the web app env (and the optional worker env):
#   npx convex env set ACTIVITYTRACK_SIGNAL_SECRET <a-long-random-secret>
ACTIVITYTRACK_SIGNAL_SECRET=
# Secret the Genesys webhook/notify endpoints (and legacy Clockodo adapter
# pushes) require (Bearer or ?secret=). Web app env only.
ACTIVITYTRACK_WEBHOOK_SECRET=
# Token Clockodo echoes in every native webhook body — must equal the value you
# enter in Clockodo's webhook "Token" field. Web app env only. If you reuse
# ACTIVITYTRACK_WEBHOOK_SECRET as that value, you can leave this blank.
CLOCKODO_WEBHOOK_TOKEN=

# Genesys Cloud OAuth client (client-credentials grant). Polling runs on the
# Convex cron, so set these in the CONVEX deployment env (and in the optional
# worker env if you run it):
#   npx convex env set GENESYS_CLIENT_ID <id>   (etc.)
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
GENESYS_REGION=mypurecloud.de   # e.g. mypurecloud.com, mypurecloud.de, mypurecloud.ie

# Clockodo API (header auth). Polling runs on the Convex cron → set in the
# CONVEX deployment env.
CLOCKODO_API_USER=              # the Clockodo account email
CLOCKODO_API_KEY=
# Comma-separated Clockodo service ids that count as a "break" (optional).
CLOCKODO_BREAK_SERVICE_IDS=
# CLOCKODO_BASE_URL=https://my.clockodo.com   # override only if needed
