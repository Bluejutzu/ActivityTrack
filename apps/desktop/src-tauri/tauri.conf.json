{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ActivityTrack",
  "version": "0.2.1",
  "identifier": "com.activitytrack.agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ActivityTrack",
        "label": "main",
        "width": 560,
        "height": 640,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "bundle/nsis/config-staging/config.json"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "bundle/nsis/installer.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBNTgxMUUyNDUxMjU1QjgKUldTNFZSSkY0aEZZNmdJdDdmVTU3WFJCc1A0SGpHR2twK0J2OFAzRXYyR2lwbFBEYjZINzhhRk4K",
      "endpoints": [
        "https://github.com/bluejutzu/activitytrack/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}