{
  "name": "@activitytrack/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ActivityTrack headless Windows activity agent (no UI). Detects active/idle via system input timing and reports to Convex.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "activitytrack-agent": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "build:installer": "node scripts/build-installer.mjs"
  },
  "dependencies": {
    "@activitytrack/shared": "workspace:*",
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
