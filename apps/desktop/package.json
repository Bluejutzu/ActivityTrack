{
  "name": "@activitytrack/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ActivityTrack tracker — a tray-resident Tauri app that detects active/idle via Win32 input timing and reports to Convex. UI is hidden on startup and locked behind a dashboard-set password.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "dotenv -- tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv-cli": "^11.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
