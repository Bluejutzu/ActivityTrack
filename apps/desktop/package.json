{
  "name": "@activitytrack/desktop",
  "version": "0.3.0",
  "private": true,
  "description": "ActivityTrack tracker — a tray-resident Tauri app that detects active/idle via Win32 input timing and reports to Convex. UI is hidden on startup and locked behind a dashboard-set password.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "dotenv -- tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-autostart": "^2.2.0",
    "@tauri-apps/plugin-cli": "~2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "dotenv-cli": "^7.4.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
